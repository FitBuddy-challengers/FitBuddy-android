<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 입력창 custom -->
    <style name="TextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/edt_auth</item>
        <item name="boxCornerRadiusTopStart">5dp</item>
        <item name="boxCornerRadiusTopEnd">5dp</item>
        <item name="boxCornerRadiusBottomStart">5dp</item>
        <item name="boxCornerRadiusBottomEnd">5dp</item>
        <item name="boxStrokeColor">@color/til_color_selector</item>
        <item name="boxStrokeErrorColor">#E94E4E</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="errorIconDrawable">@null</item>
        <item name="hintEnabled">false</item>
        <item name="hintTextAppearance">@style/HintTextStyle</item>
        <item name="errorTextAppearance">@style/ErrorTextStyle</item>
    </style>

    <style name="HintTextStyle">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14dp</item>
        <item name="android:textColor">#A6A6A6</item>
    </style>

    <style name="ErrorTextStyle">
        <item name="android:fontFamily">@font/pretendard_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14dp</item>
        <item name="android:textColor">#E94E4E</item>
    </style>

    <style name="TextInputEditTextStyle">
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14dp</item>
        <item name="android:textColor">#292929</item>
        <item name="android:background">@null</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- OTP -->
    <style name="etOTP">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textSize">24dp</item>
        <item name="android:textColor">#292929</item>
    </style>

    <!-- profile button -->
    <style name="Widget.Profile.SelectButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_profile_selector</item>
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:textColor">@color/profile_button_text_selector</item>
        <item name="android:textSize">14dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!--  운동 타이머 스타일  -->
    <style name="BottomSheetDialogTheme" parent="Theme.Design.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>
    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@color/white</item>
        <item name="shapeAppearance">@style/CustomShapeAppearanceBottomSheetDialog</item>
    </style>
    <style name="CustomShapeAppearanceBottomSheetDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">36dp</item>
        <item name="cornerSizeTopLeft">36dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <!--  텍스트칩 스타일  -->
    <style name="TextChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="android:textColor">@color/black</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/default_chip_corner_radius</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="chipStartPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAppearance">@style/ChipTextAppearance</item>
    </style>
    <style name="SelectedChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">@dimen/selected_chip_corner_radius</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="chipStartPadding">@dimen/selected_chip_padding_horizontal</item>
        <item name="chipEndPadding">@dimen/selected_chip_padding_horizontal</item>
        <item name="closeIconStartPadding">@dimen/selected_close_icon_start_padding</item>
        <item name="android:paddingTop">@dimen/selected_chip_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/selected_chip_padding_vertical</item>
        <item name="android:textAppearance">@style/ChipTextAppearance</item>
    </style>
    <style name="ChipTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="SelectedExerciseChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/light_gray</item>
        <item name="android:textColor">@color/black</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="closeIconTint">@color/black</item>
        <item name="closeIconVisible">true</item>
        <item name="android:minHeight">32dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
    </style>

    <style name="AppTheme.NoDimBottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:backgroundDimEnabled">false</item> </style>

    <!--tap 스타일-->
    <style name="tab_text" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
    </style>


    <!-- week layout -->
    <style name="tvWeekLayout">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="fontFamily">@font/pretendard_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">#7E7E7E</item>
        <item name="android:layout_weight">1</item>
    </style>


    <!--캘린더 헤더 스타일-->
    <style name="CalendarWidgetHeader">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#7E7E7E</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">31dp</item>
    </style>


    <!--캘린더 요일 행 스타일-->
    <style name="CalendarWeekDay">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#7E7E7E</item>
        <item name="android:fontFamily">@font/pretendard_semi_bold</item>
        <item name="android:paddingBottom">23dp</item>
    </style>

    <!--캘린더 오늘 날짜 스타일-->
    <style name="CalendarToday" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--캘린더 날짜 스타일-->
    <style name="CalenderViewDateCustomText" parent="android:TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">#7E7E7E</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 기본 탭 텍스트 스타일 (선택되지 않은 탭) -->
    <style name="TabTextAppearance.Default" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- 선택된 탭 텍스트 스타일 -->
    <style name="TabTextAppearance.Selected" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleShapeAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- 달력 테마 추가 -->
    <style name="CustomCalendarTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="materialCalendarTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarStyle">@style/Widget.MaterialComponents.MaterialCalendar</item>
        <item name="materialCalendarFullscreenTheme">@style/ThemeOverlay.MaterialComponents.MaterialCalendar</item>
    </style>
</resources>