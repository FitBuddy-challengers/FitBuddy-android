<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색 -->
    <solid android:color="@android:color/white"/>

    <!-- 모서리 둥글게 -->
    <corners android:radius="10dp"/>

    <!-- 테두리 (선택 사항) -->
    <stroke
        android:width="1dp"
        android:color="#d9d9d9"/>

    <!-- 내부 패딩 (선택 사항) -->
    <padding
        android:left="16dp"
        android:top="24dp"
        android:right="16dp"
        android:bottom="24dp"/>
</shape>
