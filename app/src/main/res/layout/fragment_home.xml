<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp">

        <!-- 알림 버튼 -->
        <ImageButton
            android:id="@+id/btnNoti"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/ic_home_notification"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 마이페이지 버튼 -->
        <ImageButton
            android:id="@+id/btnMypage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/ic_home_mypage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 게이지 Progress -->
        <ProgressBar
            android:id="@+id/uiGauge"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="360dp"
            android:layout_height="360dp"
            android:indeterminate="false"
            android:max="100"
            android:progressBackgroundTint="#D9D9D9"
            android:progressDrawable="@drawable/ui_home_gauge"
            app:layout_constraintTop_toBottomOf="@id/btnNoti"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- 고양이 이미지 -->
        <ImageView
            android:id="@+id/ivChar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/temp_cat"
            app:layout_constraintBottom_toTopOf="@+id/btnAiChat"
            app:layout_constraintStart_toStartOf="@id/uiGauge"
            app:layout_constraintEnd_toEndOf="@id/uiGauge"
            android:layout_marginBottom="12dp" />

        <!-- AI 채팅 버튼 -->
        <Button
            android:id="@+id/btnAiChat"
            android:layout_width="142dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="324dp"
            android:background="@drawable/btn_home_aichat"
            android:gravity="center"
            android:text="AI 채팅"
            android:textColor="@color/white"
            android:textSize="20dp"
            android:fontFamily="@font/pretendard_bold"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:tint="@null"
            android:backgroundTint="@null"
            app:layout_constraintTop_toTopOf="@+id/uiGauge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 요일 텍스트 -->
        <LinearLayout
            android:id="@+id/layoutWeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="7"
            app:layout_constraintTop_toBottomOf="@+id/btnAiChat">

            <TextView style="@style/tvWeekLayout" android:text="일"/>
            <TextView style="@style/tvWeekLayout" android:text="월"/>
            <TextView style="@style/tvWeekLayout" android:text="화"/>
            <TextView style="@style/tvWeekLayout" android:text="수"/>
            <TextView style="@style/tvWeekLayout" android:text="목"/>
            <TextView style="@style/tvWeekLayout" android:text="금"/>
            <TextView style="@style/tvWeekLayout" android:text="토"/>
        </LinearLayout>

        <!-- 날짜 선택 리사이클러뷰 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@+id/layoutWeek" />

        <!-- 운동 아이템 묶음 -->
        <LinearLayout
            android:id="@+id/WorkoutItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/view_home_list_background"
            android:padding="16dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/rvDate"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- 날짜 표시 + 추가 버튼 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/view_home_day_background"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvDay"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:fontFamily="@font/pretendard_medium"
                    android:text="2025년 n월 n일"
                    android:textColor="#7E7E7E"
                    android:textSize="16dp" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnStartWorkout"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="0dp"
                    android:background="@drawable/btn_home_start"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 운동 리스트 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="64dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

