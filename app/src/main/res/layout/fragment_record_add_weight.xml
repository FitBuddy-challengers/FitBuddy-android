<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="500dp"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_semi_bold"
        android:text="체중 기록"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/saveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="추가"
        android:textColor="@color/blue"
        android:textSize="18sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/titleTextView"
        app:layout_constraintTop_toTopOf="@id/titleTextView"/>

    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="42dp"
        app:layout_constraintTop_toBottomOf="@id/titleTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/dateTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="날짜"
        android:textColor="#A6A6A6"
        android:textSize="18sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/divider1"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/dateEditText"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:hint="오늘 날짜"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textColorHint="@color/black"
        android:background="@drawable/btn_rectangle_round5"
        android:backgroundTint="@color/light_gray2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBaseline_toBaselineOf="@id/dateTextView"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 몸무게 행 -->
    <TextView
        android:id="@+id/weightTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="몸무게 (kg)"
        android:textColor="#A6A6A6"
        android:textSize="18sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/dateTextView"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/weightEditText"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:gravity="center"
        android:textSize="18dp"
        android:textColor="@color/black"
        android:background="@drawable/btn_rectangle_round5"
        android:backgroundTint="@color/light_gray2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/weightTextView"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 체지방률 행 -->
    <TextView
        android:id="@+id/bodyFatTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="체지방률(%)"
        android:textColor="#A6A6A6"
        android:textSize="18sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/weightTextView"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/bodyFatEditText"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:gravity="center"
        android:textSize="18dp"
        android:textColor="@color/black"
        android:background="@drawable/btn_rectangle_round5"
        android:backgroundTint="@color/light_gray2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/bodyFatTextView"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 골격근량 행 -->
    <TextView
        android:id="@+id/skeletalMuscleMassTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="골격근량(kg)"
        android:textColor="#A6A6A6"
        android:textSize="18sp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/bodyFatTextView"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"/>

    <EditText
        android:id="@+id/skeletalMuscleMassEditText"
        android:layout_width="124dp"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:gravity="center"
        android:textSize="18dp"
        android:textColor="@color/black"
        android:background="@drawable/btn_rectangle_round5"
        android:backgroundTint="@color/light_gray2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBaseline_toBaselineOf="@id/skeletalMuscleMassTextView"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
