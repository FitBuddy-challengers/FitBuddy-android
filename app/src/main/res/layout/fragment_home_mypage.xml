<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".HomeMypageFragment">

    <android.widget.Button
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_back_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:text="마이페이지"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="24dp"
        android:textColor="#292929"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="36dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/userProfile"
        android:layout_width="116dp"
        android:layout_height="116dp"
        app:cardCornerRadius="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="182dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/temp_cat"
            android:layout_marginStart="8.5dp"
            android:layout_marginTop="10dp" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/userName"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        app:layout_constraintTop_toBottomOf="@+id/userProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:text="김슈니"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="24dp"
        android:textColor="#292929" />

    <TextView
        android:id="@+id/userEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/view_home_list_background"
        app:layout_constraintTop_toBottomOf="@+id/userName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="kimswuni@gmail.com"
        android:textSize="15dp"
        android:fontFamily="@font/pretendard_regular"
        android:textColor="#292929" />

    <TextView
        android:id="@+id/levelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내 레벨"
        android:textSize="20dp"
        android:textColor="#7E7E7E"
        android:fontFamily="@font/pretendard_bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/userEmail"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 레벨 표시줄 -->
    <TextView
        android:id="@+id/currentLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lv. 1"
        android:textSize="15dp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="#2777F0"
        app:layout_constraintTop_toBottomOf="@id/levelText"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/nextLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lv. 2"
        android:textSize="15dp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="#2777F0"
        app:layout_constraintTop_toTopOf="@+id/currentLevel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 임시 프로그레스바 -->
    <ImageView
        android:id="@+id/levelProgress"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:background="@color/blue"
        app:layout_constraintTop_toBottomOf="@id/currentLevel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- 메뉴 항목 -->
    <LinearLayout
        android:id="@+id/menuList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/levelProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6" />

        <TextView
            android:id="@+id/editInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="회원정보 수정"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textSize="20dp"
            android:textColor="#7E7E7E"
            android:fontFamily="@font/pretendard_bold" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6" />

        <TextView
            android:id="@+id/editAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="계정 설정"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textSize="20dp"
            android:textColor="#7E7E7E"
            android:fontFamily="@font/pretendard_bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>