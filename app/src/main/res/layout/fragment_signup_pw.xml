<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".auth.signup.SignupPwFragment">

    <android.widget.Button
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:text="로그인에 사용할\n비밀번호를 입력해 주세요"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="28dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="116dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="비밀번호"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="14dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="240dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLoginPassword"
        android:layout_width="match_parent"
        style="@style/TextInputLayoutStyle"
        app:endIconMode="password_toggle"
        app:layout_constraintTop_toBottomOf="@+id/btnBack"
        android:layout_marginTop="264dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextInputEditTextStyle"
            android:hint="8자 이상의 비밀번호"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="비밀번호 확인"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="14dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toBottomOf="@+id/tilLoginPassword"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="56dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilLoginPassword2"
        android:layout_width="match_parent"
        style="@style/TextInputLayoutStyle"
        app:endIconMode="password_toggle"
        app:layout_constraintTop_toBottomOf="@+id/tilLoginPassword"
        android:layout_marginTop="80dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextInputEditTextStyle"
            android:hint="비밀번호를 다시 입력해주세요"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <android.widget.Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:background="@drawable/btn_next_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>