<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_timer_bar" />

    <TextView
        android:id="@+id/textRestTimerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="42dp"
        android:fontFamily="@font/pretendard_semi_bold"
        android:text="휴식 타이머"
        android:textColor="@color/black"
        android:textSize="28dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutTimeOptions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button30Seconds"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/timer_time_selector"
                android:outlineProvider="none"
                android:fontFamily="@font/pretendard_semi_bold"
                android:text="0:30"
                android:textColor="@color/timer_text_selector"
                android:textSize="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button1Minute"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/timer_time_selector"
                android:outlineProvider="none"
                android:fontFamily="@font/pretendard_semi_bold"
                android:text="1:00"
                android:textColor="@color/timer_text_selector"
                android:textSize="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button1Minute30Seconds"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/timer_time_selector"
                android:outlineProvider="none"
                android:fontFamily="@font/pretendard_semi_bold"
                android:text="1:30"
                android:textColor="@color/timer_text_selector"
                android:textSize="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button2Minutes30Seconds"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/timer_time_selector"
                android:outlineProvider="none"
                android:fontFamily="@font/pretendard_semi_bold"
                android:text="2:30"
                android:textColor="@color/timer_text_selector"
                android:textSize="20dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button3Minutes"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/timer_time_selector"
                android:outlineProvider="none"
                android:fontFamily="@font/pretendard_semi_bold"
                android:text="3:00"
                android:textColor="@color/timer_text_selector"
                android:textSize="20dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/timerContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBarTimer"
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:indeterminate="false"
            android:rotation="-180"
            app:indicatorInset="0dp"
            app:indicatorSize="300dp"
            app:indicatorColor="@color/blue"
            app:trackColor="#D9D9D9"
            app:trackCornerRadius="100dp"
            app:trackThickness="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="00:30"
                android:textColor="@color/blue"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSetTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="00:30"
                android:textColor="@color/black"
                android:textSize="40sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonMinus10Seconds"
            android:layout_width="90dp"
            android:layout_height="37dp"
            android:layout_marginStart="31dp"
            android:background="@drawable/btn_rectangle_round5"
            android:backgroundTint="#D9D9D9"
            android:outlineProvider="none"
            android:text="-10초"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:fontFamily="@font/pretendard_semi_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonPlus10Seconds"
            android:layout_width="90dp"
            android:layout_height="37dp"
            android:layout_marginEnd="31dp"
            android:background="@drawable/btn_rectangle_round5"
            android:backgroundTint="#D9D9D9"
            android:outlineProvider="none"
            android:text="+10초"
            android:textColor="@color/white"
            android:textSize="24dp"
            android:fontFamily="@font/pretendard_semi_bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <Button
        android:id="@+id/buttonStartStop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="53dp"
        android:layout_marginBottom="54dp"
        android:background="@drawable/btn_rectangle_round40"
        android:backgroundTint="@color/blue"
        android:outlineProvider="none"
        android:text="휴식 시작"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white" />

</LinearLayout>