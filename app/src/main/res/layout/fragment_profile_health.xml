<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".auth.profile.ProfileHealthFragment">

    <android.widget.Button
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="66dp"
        android:text="핏버디에게 회원님의\n신체정보를 알려주세요"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="28dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="136dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="핏버디가 회원님에게 딱 맞는 운동루틴을 제공할 거예요"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="14dp"
        android:textColor="#7E7E7E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="232dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="신장"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="14dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="284dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilProfileHeight"
        android:layout_width="match_parent"
        style="@style/TextInputLayoutStyle"
        app:endIconMode="clear_text"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="308dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextInputEditTextStyle"
            android:hint="165"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:text="체중"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="14dp"
        style="@style/Theme.Challengers"
        app:layout_constraintTop_toBottomOf="@id/tilProfileHeight"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilProfileWeight"
        android:layout_width="match_parent"
        style="@style/TextInputLayoutStyle"
        app:endIconMode="clear_text"
        app:layout_constraintTop_toBottomOf="@id/tilProfileHeight"
        android:layout_marginTop="40dp">
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextInputEditTextStyle"
            android:hint="55"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/disorder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tilProfileWeight"
        android:layout_marginTop="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="17dp"
            android:text="지병"
            android:fontFamily="@font/pretendard_bold"
            android:textSize="14dp"
            style="@style/Theme.Challengers"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:text="운동 시 주의해야 할 부위가 있으신가요? (중복 선택 가능)"
            android:fontFamily="@font/pretendard_medium"
            android:textSize="12dp"
            android:textColor="#7E7E7E"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:layoutDirection="ltr">

            <Button
                style="@style/Widget.Profile.SelectButton"
                android:text="팔" />
            <Button
                style="@style/Widget.Profile.SelectButton"
                android:layout_marginLeft="8dp"
                android:text="다리" />
            <Button
                style="@style/Widget.Profile.SelectButton"
                android:layout_marginLeft="8dp"
                android:text="손목" />
            <Button
                style="@style/Widget.Profile.SelectButton"
                android:layout_marginLeft="8dp"
                android:text="발목" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:layoutDirection="ltr">

            <Button
                style="@style/Widget.Profile.SelectButton"
                android:text="무릎" />
            <Button
                style="@style/Widget.Profile.SelectButton"
                android:layout_marginLeft="8dp"
                android:text="목" />
            <Button
                style="@style/Widget.Profile.SelectButton"
                android:layout_marginLeft="8dp"
                android:text="허리" />

        </LinearLayout>

    </LinearLayout>

    <android.widget.Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="43dp"
        android:background="@drawable/btn_next_gray"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="48dp" />

</androidx.constraintlayout.widget.ConstraintLayout>