<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MypageInfoSetFragment">

    <android.widget.Button
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/btn_back_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginStart="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:text="회원정보 수정"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="20dp"
        android:textColor="#292929"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnProfileEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="변경"
        android:textColor="#2777F0"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintTop_toTopOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"/>

    <View
        android:id="@+id/lineProfile"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="106dp"/>

    <View
        android:id="@+id/bgProfile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="#F5F5F5"
        android:layout_marginTop="107dp"/>

    <!--  개인 정보 섹션  -->
    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="개인 정보"
        android:textColor="#7E7E7E"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintTop_toBottomOf="@+id/lineProfile"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <LinearLayout
        android:id="@+id/layoutInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_exercise_card"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvInfo"
        android:layout_marginTop="16dp">

        <!--  회원 이름  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="회원 이름"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp"/>

            <EditText
                android:id="@+id/etUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="김슈니"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null"
                android:inputType="textPersonName" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  연령대  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="연령대"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp"/>

            <Spinner
                android:id="@+id/spinnerAgeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/age_groups"
                android:background="@null"
                android:spinnerMode="dropdown"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  성별  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="성별"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp"/>

            <Spinner
                android:id="@+id/spinnerGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/genders"
                android:background="@null"
                android:spinnerMode="dropdown"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

    </LinearLayout>

    <!--  신체 정보 섹션  -->
    <TextView
        android:id="@+id/tvHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="신체 정보"
        android:textColor="#7E7E7E"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintTop_toBottomOf="@+id/layoutInfo"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <LinearLayout
        android:id="@+id/layoutHealth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_exercise_card"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvHealth"
        android:layout_marginTop="16dp">

        <!--  신장  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="신장"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <EditText
                android:id="@+id/etHeight"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="167"
                android:gravity="end"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cm"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  몸무게  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="몸무게"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="50"
                android:gravity="end"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  지병  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="지병"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <EditText
                android:id="@+id/etDisease"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="팔, 허리"
                android:gravity="end"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null" />

        </LinearLayout>

    </LinearLayout>

    <!--  운동 정보 섹션  -->
    <TextView
        android:id="@+id/tvWorkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="운동 정보"
        android:textColor="#7E7E7E"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintTop_toBottomOf="@+id/layoutHealth"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <LinearLayout
        android:id="@+id/layoutWorkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_exercise_card"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvWorkout"
        android:layout_marginTop="16dp">

        <!--  운동 수준  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="운동 수준"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <Spinner
                android:id="@+id/spinnerWorkoutLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/workout_level"
                android:background="@null"
                android:spinnerMode="dropdown"
                android:layout_gravity="center_vertical"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  선호 운동  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="선호 운동"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <EditText
                android:id="@+id/etPreferredWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="산책, 러닝"
                android:gravity="end"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D6D6"/>

        <!--  보유 운동 기구  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="보유 운동 기구"
                android:textColor="#292929"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="18dp" />

            <EditText
                android:id="@+id/etEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="러닝 머신, 아령"
                android:gravity="end"
                android:textSize="16dp"
                android:textColor="#4F4F4F"
                android:background="@null" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>